# Copy to .env and fill in real values. .env is git-ignored and belongs in the
# vault (rule 035); only this template is committed.

# --- Telegram (both accounts need API_ID/API_HASH) ---
API_ID=
API_HASH=
# Target channel. Authoritative; the uploader never falls back to another chat.
CHANNEL_ID=
# Optional: @username instead of the numeric id
# CHANNEL_USERNAME=
# Optional: bot token, used for files under 50 MB
TELEGRAM_TOKEN=

# --- Scraper target (site identity is personal data: never commit values) ---
TARGET_SITE_BASE_URL=
TARGET_SITE_LOGIN_URL=
# Path to the site profile (slug -> display name). Defaults to
# .storage/site_profile.json, which is a symlink into the vault.
# SITE_PROFILE=

# --- Paths ---
# Where the finished videos live; overrides .storage/media_paths.json
# VIDEO_DIR=
# Where the uploader looks for/writes processed files
# PROCESSED_DIR=processed

# --- Behaviour ---
RUN_NOW=false
CREATE_INDEX=false
ONLY_INDEX=false
RENAME_FILES=false

# Optional: private-channel invite link, used only by tools/debug/resolve_channel.py
# CHANNEL_INVITE_LINK=
